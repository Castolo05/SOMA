// NexoMente - Prisma Schema (SQLite - Local)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         String  // "PATIENT" | "PSYCHOLOGIST"

  inviteCode         String? @unique
  psychologistId     String?
  psychologistStatus String? // "PENDING", "ACCEPTED"
  psychologist       User?   @relation("PatientPsychologist", fields: [psychologistId], references: [id])
  patients       User[]  @relation("PatientPsychologist")

  journalEntries JournalEntry[]

  // Notas de sesión (reemplaza PrivateNote — ahora múltiples por sesión)
  sessionNotesWritten SessionNote[] @relation("PsychSessionNotes")
  sessionNotesAbout   SessionNote[] @relation("PatientSessionNotes")

  // Citas
  appointmentsCreated   Appointment[] @relation("PsychologistAppointments")
  appointmentsAsPatient Appointment[] @relation("PatientAppointments")

  // Objetivos terapéuticos
  goalsAsPatient   TherapyGoal[] @relation("PatientGoals")
  goalsAsTherapist TherapyGoal[] @relation("TherapistGoals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model JournalEntry {
  id        String   @id @default(cuid())
  patientId String
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  moodScore         Int    // 1 a 10
  content           String
  tags              String @default("[]") // JSON string
  flaggedForSession Boolean @default(false) // ← marcar para hablar en sesión

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("journal_entries")
}

// ============================================================
// MODELO: SessionNote (Notas clínicas por sesión — múltiples)
// ============================================================
model SessionNote {
  id             String   @id @default(cuid())
  psychologistId String
  psychologist   User     @relation("PsychSessionNotes", fields: [psychologistId], references: [id], onDelete: Cascade)

  patientId      String
  patient        User     @relation("PatientSessionNotes", fields: [patientId], references: [id], onDelete: Cascade)

  sessionDate    DateTime @default(now())  // Fecha de la sesión
  title          String   @default("")     // Título breve (ej: "Sesión 10/08")
  content        String   @default("")     // Contenido de la nota

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("session_notes")
}

// ============================================================
// MODELO: Appointment (Citas del Psicólogo)
// ============================================================
model Appointment {
  id             String   @id @default(cuid())
  psychologistId String
  psychologist   User     @relation("PsychologistAppointments", fields: [psychologistId], references: [id], onDelete: Cascade)

  patientId      String?
  patient        User?    @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: SetNull)

  title          String
  date           DateTime
  duration       Int      @default(50)
  notes          String   @default("")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("appointments")
}

// ============================================================
// MODELO: TherapyGoal (Objetivos terapéuticos)
// ============================================================
model TherapyGoal {
  id             String   @id @default(cuid())
  psychologistId String
  psychologist   User     @relation("TherapistGoals", fields: [psychologistId], references: [id], onDelete: Cascade)

  patientId      String
  patient        User     @relation("PatientGoals", fields: [patientId], references: [id], onDelete: Cascade)

  text           String   // Descripción de la meta
  completed      Boolean  @default(false)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("therapy_goals")
}
